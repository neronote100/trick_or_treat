{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trick-or-treat-collection",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/images/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trick-or-treat-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "trick-or-treat-images"
    }
  ]
}
